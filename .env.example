# Copy to .env for local runs (never commit .env). On Render/Railway add these in the dashboard instead.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ADMIN_EMAIL=admin@tejasphotography.com
ADMIN_PASSWORD=ChangeThisNow123
ADMIN_PHONE=+919999999999
CORS_ORIGINS=https://your-site.vercel.app,https://*.vercel.app,http://localhost:3000
MAX_CONFIRMED_PER_DAY=1
# WhatsApp Cloud API (optional - leave false to use the dashboard WhatsApp button only)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_MODE=template
WHATSAPP_CONFIRMED_TEMPLATE=booking_confirmed
